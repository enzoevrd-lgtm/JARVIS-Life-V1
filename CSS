:root {
color-scheme: dark;
--bg: #070b14;
--panel: #0e1625;
--panel-light: #121f32;
--border: #22354d;
--cyan: #54dfff;
--blue: #398cff;
--text: #edf6ff;
--muted: #8ca0b9;
}

* { box-sizing: border-box; }

body {
margin: 0;
min-height: 100vh;
background: var(--bg);
color: var(--text);
font-family: Inter, system-ui, -apple-system, sans-serif;
}

button, input { font: inherit; }
button { cursor: pointer; }

.app { min-height: 100vh; display: flex; }

.sidebar {
width: 250px;
flex-shrink: 0;
padding: 28px 18px;
background: #090f1b;
border-right: 1px solid var(--border);
display: flex;
flex-direction: column;
}

.brand { display: flex; gap: 12px; align-items: center; }

.brand-icon {
width: 43px;
height: 43px;
display: grid;
place-items: center;
border: 1px solid var(--cyan);
border-radius: 13px;
color: var(--cyan);
font-size: 25px;
box-shadow: 0 0 20px #54dfff22;
}

.brand h1 { margin: 0; font-size: 15px; letter-spacing: 2px; }
.brand p, .sidebar-bottom p { margin: 5px 0 0; font-size: 9px; color: var(--muted); letter-spacing: 1.5px; }

.system-status, .online {
display: flex;
align-items: center;
gap: 8px;
color: #9cc9d8;
font-size: 10px;
letter-spacing: 1px;
}

.system-status {
margin: 40px 0 22px;
padding: 12px 8px;
border: 1px solid var(--border);
border-radius: 9px;
}

.status-dot {
display: inline-block;
width: 7px;
height: 7px;
flex-shrink: 0;
border-radius: 50%;
background: #48e3a1;
box-shadow: 0 0 10px #48e3a177;
}

nav { display: grid; gap: 8px; }

.nav-item {
padding: 13px;
text-align: left;
color: var(--muted);
background: transparent;
border: 1px solid transparent;
border-radius: 9px;
}

.nav-item:hover, .nav-item.active {
color: var(--cyan);
background: #102237;
border-color: #25415b;
}

.sidebar-bottom { margin-top: auto; padding-top: 35px; }

.main { min-width: 0; flex: 1; padding: 25px clamp(16px, 4vw, 55px); }

.topbar {
display: flex;
justify-content: space-between;
align-items: center;
gap: 16px;
padding-bottom: 22px;
border-bottom: 1px solid var(--border);
}

.eyebrow { color: var(--cyan); font-size: 10px; letter-spacing: 2px; }

.topbar h2 { margin: 6px 0 0; font-size: clamp(20px, 3vw, 28px); }
.muted, .hint { color: var(--muted); line-height: 1.6; }
.online { white-space: nowrap; }

.hero { text-align: center; padding: 24px 0 20px; }
.hero h2 { font-size: clamp(21px, 3vw, 30px); margin: 12px 0; }
.hero .muted { font-size: 13px; }

.orb {
width: 100px;
height: 100px;
margin: 0 auto 18px;
display: grid;
place-items: center;
border: 1px solid #54dfff88;
border-radius: 50%;
background: radial-gradient(circle, #1d729766, #0b1830 70%);
box-shadow: 0 0 35px #329fff30, inset 0 0 25px #54dfff20;
animation: pulse 4s ease-in-out infinite;
}

.orb-core {
width: 54px;
height: 54px;
display: grid;
place-items: center;
border: 1px solid var(--cyan);
border-radius: 50%;
color: var(--cyan);
font-size: 28px;
}

@keyframes pulse {
50% { box-shadow: 0 0 48px #329fff55, inset 0 0 30px #54dfff35; }
}

.chat-panel, .content-panel {
max-width: 900px;
margin: 0 auto;
background: var(--panel);
border: 1px solid var(--border);
border-radius: 14px;
padding: 18px;
}

.chat-messages {
display: flex;
flex-direction: column;
gap: 12px;
min-height: 150px;
max-height: 340px;
overflow-y: auto;
padding: 4px 2px 16px;
}

.message {
max-width: 85%;
padding: 13px 15px;
border: 1px solid var(--border);
border-radius: 4px 12px 12px;
line-height: 1.6;
white-space: pre-wrap;
overflow-wrap: anywhere;
}

.jarvis-message { background: #132338; align-self: flex-start; }
.user-message { background: #123a54; align-self: flex-end; border-radius: 12px 4px 12px 12px; }

.message-label {
display: block;
margin-bottom: 5px;
color: var(--cyan);
font-size: 10px;
letter-spacing: 1px;
}

.chat-form, .task-form { display: flex; gap: 10px; }

input {
width: 100%;
min-width: 0;
padding: 13px 14px;
color: var(--text);
background: #080f1c;
border: 1px solid var(--border);
border-radius: 9px;
outline: none;
}

input:focus { border-color: var(--cyan); box-shadow: 0 0 0 2px #54dfff15; }

.primary-button, .secondary-button {
padding: 12px 16px;
border-radius: 9px;
white-space: nowrap;
font-weight: 650;
}

.primary-button {
color: #04121e;
border: 1px solid var(--cyan);
background: var(--cyan);
}

.primary-button:hover { background: #a2efff; }

.secondary-button {
color: var(--text);
border: 1px solid var(--border);
background: var(--panel-light);
}

.hint { font-size: 11px; margin-bottom: 0; }

.quick-actions {
max-width: 900px;
margin: 15px auto 0;
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 12px;
}

.quick-card {
display: grid;
gap: 9px;
padding: 16px;
text-align: left;
color: var(--text);
background: var(--panel);
border: 1px solid var(--border);
border-radius: 12px;
}

.quick-card:hover { border-color: var(--cyan); transform: translateY(-1px); }
.quick-card span { color: var(--cyan); font-size: 22px; }
.quick-card strong { font-size: 13px; }
.quick-card small { color: var(--muted); }

.content-panel { max-width: 900px; margin-top: 30px; }
.content-panel h3 { margin-top: 0; }
.task-form { margin: 22px 0; }

.task-list { display: grid; gap: 9px; }

.task-row {
display: flex;
align-items: center;
gap: 10px;
padding: 12px;
background: #0a1220;
border: 1px solid var(--border);
border-radius: 9px;
}

.task-row span { flex: 1; overflow-wrap: anywhere; }
.task-row.done span { color: var(--muted); text-decoration: line-through; }
.task-row button { color: #ff9caa; border: 0; background: transparent; }
.task-row input { width: 17px; }

.account-panel form { display: grid; gap: 10px; }
.account-panel label { margin-top: 8px; color: #b9cbe0; font-size: 13px; }
.auth-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
.notice { color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
.app-notice { max-width: 900px; margin: 15px auto 0; color: var(--cyan); font-size: 13px; }
footer { padding: 35px 0 8px; text-align: center; color: #60748c; font-size: 9px; letter-spacing: 2px; }
.hidden { display: none !important; }

@media (max-width: 720px) {
.app { flex-direction: column; }
.sidebar { width: 100%; padding: 15px; border-right: 0; border-bottom: 1px solid var(--border); }
.system-status, .sidebar-bottom { display: none; }
nav { display: flex; gap: 6px; margin-top: 16px; }
.nav-item { flex: 1; padding: 10px 5px; text-align: center; font-size: 12px; }
.main { padding: 18px 13px; }
.quick-actions { grid-template-columns: 1fr; }
.quick-card { grid-template-columns: auto 1fr; align-items: center; }
.quick-card small { grid-column: 2; }
.chat-form, .task-form { flex-direction: column; }
.chat-form button, .task-form button { width: 100%; }
.message { max-width: 96%; }
}

