import { createClient } from
"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm";

// Remplace ces deux valeurs par celles de TON projet Supabase.
const SUPABASE_URL = "TON_URL_SUPABASE";
const SUPABASE_PUBLISHABLE_KEY = "TA_CLE_PUBLIQUE_SUPABASE";

export const isSupabaseConfigured =
SUPABASE_URL.startsWith("https://") &&
SUPABASE_URL.endsWith(".supabase.co") &&
SUPABASE_PUBLISHABLE_KEY !== "TA_CLE_PUBLIQUE_SUPABASE" &&
SUPABASE_PUBLISHABLE_KEY.trim().length > 0;

export const supabase = isSupabaseConfigured
? createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY)
: null;
